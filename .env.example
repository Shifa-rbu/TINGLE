# Copy this file to .env and fill in your own values. Never commit .env.
# Sample/demo mode works without any of these.

# Which model provider to use (only "anthropic" is implemented)
TINGLE_PROVIDER=anthropic

# Your Anthropic API key (placeholder only: put the real key in your private .env)
ANTHROPIC_API_KEY=your-api-key-here

# Optional settings
TINGLE_MODEL=claude-sonnet-5-5
TINGLE_TIMEOUT_SECONDS=60
TINGLE_MAX_TOKENS=1500
